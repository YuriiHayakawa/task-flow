# Banco de dados
DATABASE_URL=postgresql+psycopg://taskflow:taskflow@localhost:5432/taskflow

# Autenticação (JWT)
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_EXPIRE_MINUTES=60

# Timezone da aplicação (usada para calcular "hoje"/"atrasada"/"vencendo hoje" — research.md #9)
APP_TIMEZONE=America/Sao_Paulo

# Anexos (armazenamento local em disco — research.md #12)
ATTACHMENTS_DIR=uploads
ATTACHMENTS_MAX_SIZE_BYTES=10485760
ATTACHMENTS_ALLOWED_CONTENT_TYPES=image/png,image/jpeg,application/pdf,text/plain

# Tarefa periódica de notificações DUE_SOON (research.md #2)
DUE_SOON_CHECK_INTERVAL_SECONDS=60
DUE_SOON_WINDOW_HOURS=24
DUE_SOON_LOCK_KEY=918273645
